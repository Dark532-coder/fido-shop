# ═══════════════════════════════════════════════
# Fido's Shop — Configuration Template
# ═══════════════════════════════════════════════
# Copiez ce fichier en .env et renseignez vos valeurs

# Server
PORT=3001
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3001

# JWT Secret (CHANGEZ CETTE VALEUR EN PRODUCTION!)
JWT_SECRET=

# PayDunya — Clés API Marchand
# Obtenez vos clés sur https://paydunya.com
# Mode: 'test' pour le développement, 'live' pour la production
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
